{
  "name": "broknowmygitdesktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:i18n && vue-tsc --noEmit && vite build",
    "check": "pnpm lint:css && pnpm check:release && pnpm build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:release": "node --test scripts/release-version-utils.test.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "release:prepare": "node scripts/set-version.mjs",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "highlight.js": "^11.11.1",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
